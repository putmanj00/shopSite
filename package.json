{
  "name": "shop-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run contrast:check && next build",
    "start": "next start",
    "prepare": "lefthook install",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "a11y:test": "npx tsx scripts/accessibility-test.ts",
    "contrast:check": "npx tsx scripts/color-contrast-checker.ts",
    "a11y:all": "npm run contrast:check && npm run a11y:test",
    "test:ui": "npx tsx scripts/ui-tests.ts",
    "test:routes": "npx tsx scripts/validate-routes.ts",
    "test:all": "npm run typecheck && npm run lint && npm run test:ui",
    "tunnel": "npx localtunnel --port 3000"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@shopify/storefront-api-client": "^1.0.9",
    "@tailwindcss/typography": "^0.5.19",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.34.3",
    "graphql": "^16.13.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.9.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "lefthook": "^2.1.1",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
