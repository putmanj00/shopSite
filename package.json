{
  "name": "shop-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "CONTRAST_STRICT=1 npm run contrast:check && next build",
    "start": "next start",
    "prepare": "lefthook install",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "a11y:test": "npx tsx scripts/accessibility-test.ts",
    "contrast:check": "npx tsx scripts/color-contrast-checker.ts",
    "test:button": "npx tsx scripts/button-variants.test.ts",
    "test:entry": "npx tsx scripts/product-entry.test.ts",
    "test:care": "npx tsx scripts/care-guides.test.ts",
    "a11y:all": "npm run contrast:check && npm run a11y:test",
    "test:ui": "npx tsx scripts/ui-tests.ts",
    "test:routes": "npx tsx scripts/validate-routes.ts",
    "test:webhook": "npx tsx scripts/test-webhook.ts",
    "test:autofix": "node --test 'scripts/codex-autofix/*.test.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run typecheck && npm run lint && npm run test:ui && npm run test:care",
    "tunnel": "npx localtunnel --port 3000"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.5",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.75.0",
    "@shopify/storefront-api-client": "^2.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^13.4.0",
    "graphql": "^17.0.2",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.14",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^7"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
