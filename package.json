{
  "name": "shop-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "CONTRAST_STRICT=1 npm run contrast:check && next build",
    "start": "next start",
    "prepare": "lefthook install",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "a11y:test": "npx tsx scripts/accessibility-test.ts",
    "contrast:check": "npx tsx scripts/color-contrast-checker.ts",
    "test:button": "npx tsx scripts/button-variants.test.ts",
    "test:entry": "npx tsx scripts/product-entry.test.ts",
    "test:care": "npx tsx scripts/care-guides.test.ts",
    "test:return-to": "npx tsx scripts/safe-return-to.test.ts",
    "test:auth-errors": "npx tsx scripts/auth-errors.test.ts",
    "test:catalog-lint": "npx tsx scripts/catalog-lint.test.ts",
    "catalog:lint": "npx tsx scripts/catalog-lint.ts",
    "test:signup": "npx tsx scripts/customer-signup.test.ts",
    "test:customer-address": "npx tsx scripts/customer-address.test.ts",
    "test:csp-report": "npx tsx scripts/csp-report.test.ts",
    "a11y:all": "npm run contrast:check && npm run a11y:test",
    "test:ui": "npx tsx scripts/ui-tests.ts",
    "test:routes": "npx tsx scripts/validate-routes.ts",
    "test:webhook": "npx tsx scripts/test-webhook.ts",
    "test:autofix": "node --test 'scripts/codex-autofix/*.test.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:all": "npm run typecheck && npm run lint && npm run test:ui && npm run test:care",
    "tunnel": "npx localtunnel --port 3000"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@react-email/render": "^2.0.10",
    "@sentry/nextjs": "^11.13.0",
    "@shopify/storefront-api-client": "^2.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "framer-motion": "^14.14.0",
    "graphql": "^17.1.0",
    "next": "^16.2.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "lefthook": "^2.2.2",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^6"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
