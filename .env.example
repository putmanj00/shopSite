# Required for build, storefront rendering, and Shopify-backed E2E tests.
# Use the permanent myshopify.com domain, not wildenflower.com.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=replace-with-storefront-token

# Required only for Shopify-backed E2E tests.
# These default to the historical test product from .planning/phases/19-playwright-e2e-tests/test-product.md.
E2E_TEST_PRODUCT_HANDLE=wildenflower-test-product
E2E_TEST_PRODUCT_TITLE=Wildenflower Test Product

# Required for Customer Account API routes, not needed for read-only storefront pages.
SHOPIFY_SHOP_ID=replace-with-numeric-shop-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=replace-with-customer-account-client-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=

# Required for admin/test admin routes only.
SHOPIFY_CLIENT_ID=replace-with-admin-client-id
SHOPIFY_CLIENT_SECRET=replace-with-admin-client-secret

# Required for email flows and go-live webhook verification.
RESEND_API_KEY=replace-with-resend-key
SHOPIFY_WEBHOOK_SECRET=replace-with-webhook-secret
# Sender for order emails. MUST be on a Resend-verified domain. Optional —
# defaults to "Wildenflower <orders@wildenflower.com>" (see lib/email.ts).
EMAIL_FROM=Wildenflower <orders@wildenflower.com>
